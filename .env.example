ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=kalpi
POSTGRES_PASSWORD=kalpi
POSTGRES_DB=kalpi
# Used by `make run` on the host; docker compose overrides this for the api container
DATABASE_URL=postgresql+psycopg://kalpi:kalpi@localhost:5433/kalpi

NOTIFICATION_WEBHOOK_URL=

# --- Broker credentials (secrets: never commit real values) ---------------------------
# Only the broker you execute against needs to be set. Access tokens expire (most daily)
# and come from each broker's login flow, which this service does not perform.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# FYERS_API_KEY is the app id, e.g. XXXX-100
FYERS_API_KEY=
FYERS_ACCESS_TOKEN=

ANGELONE_API_KEY=
ANGELONE_ACCESS_TOKEN=
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=127.0.0.1
ANGELONE_MAC_ADDRESS=00:00:00:00:00:00

UPSTOX_ACCESS_TOKEN=
GROWW_ACCESS_TOKEN=

# Mock broker demo behaviour (JSON). fail values: reject | unavailable | rate_limit | unknown
MOCK_HOLDINGS={"INFY": 10, "TCS": 5}
MOCK_FAIL={}
