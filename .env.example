ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=kalpi
POSTGRES_PASSWORD=kalpi
POSTGRES_DB=kalpi
# Used by `make run` on the host; docker compose overrides this for the api container
DATABASE_URL=postgresql+psycopg://kalpi:kalpi@localhost:5433/kalpi

NOTIFICATION_WEBHOOK_URL=

ORDER_TIMEOUT_SECONDS=30
ORDER_POLL_INTERVAL_SECONDS=1
MARKET_CLOSE_IST=15:30

# --- Broker connections -------------------------------------------------------------
# Users connect their own broker account (PUT /api/v1/brokers/{broker}/connection); the
# access token is stored encrypted with these Fernet keys (comma-separated, newest first).
# `make env` generates one. Never commit a real key.
TOKEN_ENCRYPTION_KEYS=

# --- Broker app settings (identify Kalpi's app to the broker, not the user) ----------
ZERODHA_API_KEY=

# FYERS_API_KEY is the app id, e.g. XXXX-100
FYERS_API_KEY=

ANGELONE_API_KEY=
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=127.0.0.1
ANGELONE_MAC_ADDRESS=00:00:00:00:00:00

# Mock broker demo behaviour. MOCK_CASH empty = unlimited funds.
# MOCK_FAIL values: reject | unavailable | rate_limit | unknown | lost | open | partial | auth
MOCK_HOLDINGS={"INFY": 10, "TCS": 5}
MOCK_CASH=
MOCK_FAIL={}
