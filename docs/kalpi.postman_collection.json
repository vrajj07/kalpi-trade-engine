          ]
        },
        {
          "name": "Both target and instructions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$randomUUID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/executions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "executions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"broker\": \"mock\",\n  \"target\": [\n    {\n      \"symbol\": \"INFY\",\n      \"quantity\": 1\n    }\n  ],\n  \"instructions\": [\n    {\n      \"action\": \"BUY\",\n      \"symbol\": \"WIPRO\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
